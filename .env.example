# ==============================================================================
# MurderMystiQL Backend Environment Configuration
# ==============================================================================

# Server Environment
APP_NAME="MurderMystiQL Backend"
APP_ENV="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Secret Key for session signing if needed
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"

# Database Connection Strings (PostgreSQL)
# POOL 1: game_owner role (Read/Write to 'game' schema)
# Format: postgresql+asyncpg://game_owner:PASSWORD@HOST:PORT/DATABASE
GAME_DATABASE_URL="postgresql+asyncpg://game_owner:GameOwnerSecurePass123!@localhost:5432/murdermystiql"

# POOL 2: investigator_ro role (Strictly Read-Only to 'investigation' schema)
# Format: postgresql://investigator_ro:PASSWORD@HOST:PORT/DATABASE or postgresql+asyncpg://...
INVESTIGATOR_DATABASE_URL="postgresql://investigator_ro:InvestigatorReadOnlyPass123!@localhost:5432/murdermystiql"

# Participant SQL Execution Constraints
STATEMENT_TIMEOUT_MS=5000
MAX_QUERY_ROWS=500
INVESTIGATOR_POOL_MIN_SIZE=5
INVESTIGATOR_POOL_MAX_SIZE=10

# Game Rule Penalties & Durations (in seconds)
WRONG_ANSWER_LOCK_SECONDS=60
WRONG_ANSWER_PENALTY_SECONDS=300

# Static Frontend Directory (Optional: built React frontend)
# If provided, FastAPI will serve index.html and static assets for LAN participants
FRONTEND_DIST_DIR="../murder-mystiql-frontend/dist"

# CORS Configuration (LAN accessibility)
CORS_ORIGINS=["*"]
